# ── GA4 ──────────────────────────────────────────────────────────────────────
# GA4 Property ID (only the numeric ID, e.g. 123456789)
GA4_PROPERTY_ID=

# Path to your Google Service Account JSON key file
# The service account needs "Viewer" access on the GA4 property
GOOGLE_APPLICATION_CREDENTIALS=./credentials/ga4-service-account.json

# ── VTEX ─────────────────────────────────────────────────────────────────────
VTEX_ACCOUNT=
VTEX_APP_KEY=
VTEX_APP_TOKEN=
# Environment: vtexcommercestable (prod) or vtexcommercebeta (staging)
VTEX_ENVIRONMENT=vtexcommercestable

# ── CitrusAd ─────────────────────────────────────────────────────────────────
CITRUS_API_KEY=
# Your CitrusAd tenant/customer ID
CITRUS_CUSTOMER_ID=
# Override base URL if using a private cloud / on-prem instance
CITRUS_API_URL=https://api.citrusad.com
